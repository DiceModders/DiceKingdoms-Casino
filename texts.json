  "gamekey:building.24.name": { "en": "Casino", "de": "Kasino", "fr": "Casino", "ru": "Казино", "uk": "Казино", "zh-CN": "赌场" },
  "gamekey:building.24.effect": {
    "en": "Spin the wheel of fortune now and then: win resources or send a tsunami to everyone else, or bring a disaster on yourself.",
