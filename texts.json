  "rule.casino.jackpot.description": { "en": "Chance of a tsunami on every other player.", "de": "Chance auf einen Tsunami auf jeden anderen Spieler.", "fr": "Chance d'un tsunami sur chaque autre joueur.", "ru": "Шанс цунами на каждого другого игрока.", "uk": "Шанс цунамі на кожного іншого гравця.", "zh-CN": "对其他每位玩家发动海啸的概率。" },
