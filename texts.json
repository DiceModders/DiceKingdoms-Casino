  "rule.casino.win.description": { "en": "Chance of winning gold or some of each resource.", "de": "Chance, Gold oder etwas von jedem Rohstoff zu gewinnen.", "fr": "Chance de gagner de l'or ou un peu de chaque ressource.", "ru": "Шанс выиграть золото или немного каждого ресурса.", "uk": "Шанс виграти золото або трохи кожного ресурсу.", "zh-CN": "赢得金币或每种资源若干的概率。" },
  "rule.casino.bad.title": { "en": "Bad luck chance (%)", "de": "Pech-Chance (%)", "fr": "Chance de malchance (%)", "ru": "Шанс неудачи (%)", "uk": "Шанс невдачі (%)", "zh-CN": "倒霉概率（%）" },
  "rule.casino.bad.description": { "en": "Chance of robbers from another island or a fire on your island.", "de": "Chance auf Räuber einer anderen Insel oder ein Feuer auf deiner Insel.", "fr": "Chance de voleurs d'une autre île ou d'un incendie sur votre île.", "ru": "Шанс грабителей с другого острова или пожара на вашем острове.", "uk": "Шанс грабіжників з іншого острова або пожежі на вашому острові.", "zh-CN": "另一座岛的强盗或你岛上发生火灾的概率。" },
