  "rule.casino.winGold.description": { "en": "Gold a gold win gives.", "de": "Gold, das ein Goldgewinn bringt.", "fr": "Or que rapporte un gain en or.", "ru": "Сколько золота даёт выигрыш золота.", "uk": "Скільки золота дає виграш золота.", "zh-CN": "金币奖励给予的金币数。" },
  "rule.casino.winEach.title": { "en": "Win of each resource", "de": "Gewinn von jedem Rohstoff", "fr": "Gain de chaque ressource", "ru": "Выигрыш каждого ресурса", "uk": "Виграш кожного ресурсу", "zh-CN": "每种资源奖励" },
